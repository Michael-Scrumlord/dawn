{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .nug-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media screen and (min-width: 850px) {
    .nug-hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .nug-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.2rem;
    border-radius: 9999px;
    background: #F7D570;
    color: #3E2614;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 10px rgba(247, 213, 112, 0.4);
  }

  .nug-hero-title {
    font-size: clamp(2.5rem, 5vw + 1rem, 4.2rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #3E2614;
    margin-bottom: 1.5rem;
  }

  .nug-hero-title span.highlight {
    color: #E4A13A;
    position: relative;
    display: inline-block;
  }

  .nug-hero-title span.highlight::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 8px;
    background: rgba(247, 213, 112, 0.45);
    border-radius: 4px;
    z-index: -1;
  }

  .nug-hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #5C4028;
    margin-bottom: 2.2rem;
    max-width: 520px;
  }

  .nug-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .nug-hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(62, 38, 20, 0.12);
  }

  .nug-trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #3E2614;
  }

  /* Mascot Visual Showcase */
  .nug-hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .nug-mascot-backdrop {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(247, 213, 112, 0.6) 0%, rgba(228, 161, 58, 0.15) 70%, transparent 100%);
    filter: blur(20px);
    z-index: 1;
  }

  .nug-mascot-card {
    position: relative;
    z-index: 2;
    background: #FFFDF7;
    border: 3px solid #FFF6DE;
    border-radius: 36px;
    padding: 2.5rem 2rem;
    box-shadow: 0 20px 40px rgba(62, 38, 20, 0.12);
    text-align: center;
    width: 100%;
    max-width: 380px;
  }

  .nug-mascot-img {
    width: 220px;
    height: 220px;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgba(62, 38, 20, 0.2));
    animation: nug-float 3.5s ease-in-out infinite;
  }

  .nug-pill-tag {
    position: absolute;
    padding: 0.5rem 1rem;
    background: #FFFFFF;
    border: 2px solid #E4A13A;
    border-radius: 9999px;
    font-weight: 800;
    font-size: 0.8rem;
    color: #3E2614;
    box-shadow: 0 8px 16px rgba(62, 38, 20, 0.1);
    z-index: 3;
    white-space: nowrap;
  }

  .nug-pill-tag--top {
    top: 15px;
    right: -15px;
    transform: rotate(6deg);
  }

  .nug-pill-tag--bottom {
    bottom: 25px;
    left: -20px;
    transform: rotate(-5deg);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="nug-hero-grid">
      <!-- Content Column -->
      <div class="nug-hero-content">
        {%- if section.settings.badge_text != blank -%}
          <div class="nug-hero-badge">
            <span>{{ section.settings.badge_icon | default: '⚡' }}</span>
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        <h1 class="nug-hero-title">
          {{ section.settings.heading_line_1 }}<br>
          <span class="highlight">{{ section.settings.heading_highlight }}</span>
        </h1>

        <p class="nug-hero-subtitle">
          {{ section.settings.subheading }}
        </p>

        <div class="nug-hero-actions">
          {%- if section.settings.button_label_1 != blank -%}
            <a href="{{ section.settings.button_link_1 }}" class="button button--primary">
              {{ section.settings.button_label_1 }}
            </a>
          {%- endif -%}

          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>

        <div class="nug-hero-trust">
          <div class="nug-trust-item">
            <span>🛠️</span>
            <span>Artisan Handcrafted</span>
          </div>
          <div class="nug-trust-item">
            <span>💾</span>
            <span>Instant Digital Access</span>
          </div>
          <div class="nug-trust-item">
            <span>📦</span>
            <span>Insured Shipping</span>
          </div>
        </div>
      </div>

      <!-- Mascot Showcase Column -->
      <div class="nug-hero-visual">
        <div class="nug-mascot-backdrop"></div>
        <div class="nug-mascot-card">
          <div class="nug-pill-tag nug-pill-tag--top">⚡ 100% Original Creations</div>
          <img
            src="{{ 'nug-mascot.png' | asset_url }}"
            alt="NugMe Mascot"
            width="220"
            height="220"
            class="nug-mascot-img"
          >
          <div class="nug-pill-tag nug-pill-tag--bottom">🔥 Gourmet Heat Attack!</div>
          <div style="margin-top: 1rem; font-weight: 800; font-size: 1.1rem; color: #3E2614;">
            Meet Nuggy
          </div>
          <div style="font-size: 0.85rem; color: #8A6548;">
            Studio Mascot & Craft Guardian
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NugMe Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "badge_icon",
      "label": "Badge Icon",
      "default": "⚡"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FRESH OFF THE FRYER"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading Line 1",
      "default": "Gear For The Real"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlighted Word",
      "default": "Nugget Lovers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Welcome to nugme.org — the official home of crispy apparel, hot sauces, and collectible merchandise crafted for the crunch obsessed."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label",
      "default": "Shop The Drop"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Explore Sauces"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link",
      "default": "/collections/all"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "NugMe Hero"
    }
  ]
}
{% endschema %}
