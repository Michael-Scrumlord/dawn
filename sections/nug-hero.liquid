{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="nug-hero-section color-{{ section.settings.color_scheme }}">
  <details class="nug-hero-disclosure" open>
    {%- if section.settings.enable_collapse -%}
      <summary class="nug-hero-toggle page-width" aria-label="Toggle introduction">
        <span class="nug-hero-toggle__control" aria-hidden="true">
          <svg class="nug-hero-toggle__icon" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 8L8 2L14 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </summary>
    {%- endif -%}

    <div class="page-width section-{{ section.id }}-padding">
      <div class="nug-hero-grid">
        <div class="nug-hero-content">
          {%- if section.settings.badge_text != blank -%}
            <p class="nug-hero-kicker">{{ section.settings.badge_text }}</p>
          {%- endif -%}

          <h1 class="nug-hero-title">
            {{ section.settings.heading_line_1 }}
            <span>{{ section.settings.heading_highlight }}</span>
          </h1>

          <p class="nug-hero-subtitle">{{ section.settings.subheading }}</p>

          <div class="nug-hero-actions">
            {%- if section.settings.button_label_1 != blank -%}
              <a href="{{ section.settings.button_link_1 }}" class="button button--primary">
                {{ section.settings.button_label_1 }}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
                {{ section.settings.button_label_2 }}
              </a>
            {%- endif -%}
          </div>
        </div>

        <div class="nug-hero-visual" aria-label="NugMe Studio Character">
          <div class="nug-mascot-frame">
            <span class="nug-mascot-badge">Studio Mascot</span>
            <img
              src="{{ 'nug-mascot.png' | asset_url }}"
              alt="Nuggy, NugMe Studio Mascot"
              width="240"
              height="240"
              class="nug-mascot-img"
            >
            <div class="nug-mascot-caption">
              <strong>Nuggy</strong>
              <span>Workshop Quality Mascot</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </details>
</div>

{% schema %}
{
  "name": "NugMe Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Kicker",
      "default": "NUGME STUDIO"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "One studio."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading line 2",
      "default": "An unreasonable number of tools."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hand-bound books, sewn canvas goods, lace, woodburning, software, and original audio from one independent studio."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label",
      "default": "Browse the collection"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Explore digital goods"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "enable_collapse",
      "label": "Allow visitors to collapse the hero",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "NugMe Hero"
    }
  ]
}
{% endschema %}
