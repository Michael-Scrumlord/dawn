<div class="nug-departments color-{{ section.settings.color_scheme }}">
  <div class="page-width nug-departments__inner">
    <p class="nug-departments__title">{{ section.settings.subheading | default: 'Explore Studio Disciplines' }}</p>
    <nav class="nug-departments__list" aria-label="Product disciplines">
      <a href="{{ routes.all_products_collection_url }}" class="nug-department{% if request.path == routes.all_products_collection_url and search.terms == blank %} is-active{% endif %}">All Works</a>
      <a href="{{ routes.search_url }}?q=software&amp;type=product" class="nug-department{% if search.terms contains 'software' %} is-active{% endif %}">Software</a>
      <a href="{{ routes.search_url }}?q=music&amp;type=product" class="nug-department{% if search.terms contains 'music' %} is-active{% endif %}">Music &amp; Audio</a>
      <a href="{{ routes.search_url }}?q=book&amp;type=product" class="nug-department{% if search.terms contains 'book' %} is-active{% endif %}">Books &amp; Journals</a>
      <a href="{{ routes.search_url }}?q=canvas&amp;type=product" class="nug-department{% if search.terms contains 'canvas' %} is-active{% endif %}">Canvas Goods</a>
      <a href="{{ routes.search_url }}?q=woodburning&amp;type=product" class="nug-department{% if search.terms contains 'woodburning' %} is-active{% endif %}">Woodburning Art</a>
      <a href="{{ routes.search_url }}?q=lace&amp;type=product" class="nug-department{% if search.terms contains 'lace' %} is-active{% endif %}">Lacework</a>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Category Filter Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section label",
      "default": "Shop by category"
    }
  ],
  "presets": [
    {
      "name": "Category Filter Bar"
    }
  ]
}
{% endschema %}
